# Keep the build context small: only sources, manifests and instance data are needed.

# VCS and editor state
.git
.gitignore
.idea
.vscode

# Rust build output
target
**/target
**/*.rs.bk

# Nix / direnv output
result
result-*
.direnv

# Python caches and virtualenvs
**/__pycache__
**/*.py[cod]
.ruff_cache
.pytest_cache
.venv
venv

# Experiment artefacts (regenerated by the pipeline)
**/hao_run
**/experiments_hao
**/results
**/results_*

# Instance sets regenerated by preprocessing.prepare_instances
**/instances_train
**/instances_eval

# Terrain heightmaps downloaded by preprocessing.fetch_maps (~190 MB)
**/external

# Local secrets
.env
